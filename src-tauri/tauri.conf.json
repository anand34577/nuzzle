{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nuzzle",
  "version": "0.4.0",
  "identifier": "dev.companion.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Nuzzle",
        "width": 260,
        "height": 340,
        "x": 200,
        "y": 200,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Nuzzle settings",
        "url": "settings.html",
        "width": 860,
        "height": 600,
        "minWidth": 380,
        "minHeight": 460,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "visible": false
      },
      {
        "label": "area",
        "title": "Choose area",
        "url": "area.html",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A small character on your desktop that talks, listens and helps"
  }
}
