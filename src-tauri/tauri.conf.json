{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Companion",
  "version": "0.1.1",
  "identifier": "dev.companion.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Companion",
        "width": 260,
        "height": 340,
        "x": 200,
        "y": 200,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Companion settings",
        "url": "settings.html",
        "width": 860,
        "height": 600,
        "minWidth": 380,
        "minHeight": 460,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "visible": false
      },
      {
        "label": "area",
        "title": "Choose area",
        "url": "area.html",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/llama/llama-server.exe",
      "resources/llama/*.dll",
      "resources/llama/VERSION",
      "resources/llama/LICENSE*"
    ]
  }
}
